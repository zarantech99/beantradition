# Frontend environment variables (root)
# Copy this file to .env and fill in the values, then restart the dev server.

# Google Gemini API key used by services/geminiService.ts
# (exposed to the client build as process.env.API_KEY / process.env.GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the API base URL used by the frontend.
# Leave unset to use the relative '/api' path, which the Vite dev server
# proxies to the backend (see vite.config.ts).
# VITE_API_URL=/api

# Optional: override the dev proxy target if the backend does not run on
# http://localhost:5000 (for example a different port inside a container).
# VITE_API_PROXY_TARGET=http://localhost:5000
